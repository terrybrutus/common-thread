[
  {
    "match": ".well-known/ii-app-metadata",
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Cache-Control": "public, max-age=600"
    }
  },
  {
    "match": "brand/common-thread-icon.png",
    "headers": {
      "Access-Control-Allow-Origin": "*"
    }
  }
]
